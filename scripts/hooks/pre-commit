#!/bin/sh
# KSP DAPPA pre-commit gate. Enable once per clone:
#   git config core.hooksPath scripts/hooks
# It refuses a commit that (1) adds a stray shell-artefact file at a guarded
# directory level, or (2) stages a generated file that no longer matches its
# source (README service table). Both checks take well under a second.
set -e
node scripts/check_tree_hygiene.mjs --staged
if git diff --cached --name-only | grep -qE '^(README\.md|docs/service_table\.json|functions/dappa_api/lib/servicemap\.js|functions/dappa_api/catalyst-config\.json)$'; then
  node scripts/gen_service_table.mjs --check
fi
if git diff --cached --name-only | grep -qE '^(docs/CONTRACTS\.md|functions/dappa_api/lib/routes/.*|functions/dappa_api/lib/flags\.js|functions/dappa_api/lib/servicemap\.js)$'; then
  node scripts/gen_contracts.mjs --check
fi
if git diff --cached --name-only | grep -qE '^(CAPABILITIES\.md|FEATURES\.md|README\.md)$'; then
  if [ -f scripts/check_capabilities.mjs ]; then node scripts/check_capabilities.mjs; fi
fi
